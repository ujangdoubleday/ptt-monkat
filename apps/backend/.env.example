API_PORT=3000
MARIADB_DSN=monkat:changeme@tcp(127.0.0.1:3307)/ptt_monkat?parseTime=true&charset=utf8mb4
INFLUX_URL=http://127.0.0.1:8087
INFLUX_TOKEN=dev-token-ptt-monkat
INFLUX_ORG=ptt
INFLUX_BUCKET=snmp_metrics

# Poller. SNMP_TIMEOUT*(1+SNMP_RETRIES) must stay well under POLL_INTERVAL.
POLL_INTERVAL=10s
POLL_CONCURRENCY=50
SNMP_TIMEOUT=2s
SNMP_RETRIES=1
